// ---------------------------------------------------------------------------
// Schema Prisma — Studio Beyond (The Beyond)
// Banco: TiDB Cloud Serverless (MySQL-compatible)
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma" // TiDB Serverless: FKs geridas pelo Prisma, não pelo banco
}

// --------------------------------------------------- Better Auth (sessão/OAuth)
// Tabelas gerenciadas pelo Better Auth — não editar manualmente

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// --------------------------------------------------------------- Perfil/Papéis

enum AppRole {
  owner
  admin
  gerente
  author
  vip      // plano Fã
  superfa  // plano Super Fã
  reader
}

model Profile {
  id        String   @id // mesmo id do User (Better Auth)
  user      User     @relation(fields: [id], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      AppRole  @default(reader)
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  works              Work[]
  applications       AuthorApplication[]
  donationsSent      Donation[]          @relation("DonorProfile")

  @@map("profiles")
}

// ----------------------------------------------------------------- Obras

enum WorkMedium {
  livro
  manga
  hq
  conto
  lightnovel
  manhwa
  manhua
}

enum WorkStatus {
  andamento
  finalizado
  paralisado
}

enum ReviewStatus {
  pending
  approved
  rejected
  changes
  draft
}

model Work {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  medium      WorkMedium
  artistName  String       @default("")
  artistSlug  String       @default("")
  authorId    String?
  author      Profile?     @relation(fields: [authorId], references: [id])
  excerpt     String       @db.Text
  body        String       @db.LongText
  coverUrl    String?      @db.Text
  pdfUrl      String?      @db.Text
  previewUrl  String?      @db.Text // prévia (2 primeiras páginas) para quem não está logado
  pdfPages    Int? // número de páginas do PDF
  genre       String?
  tags        String?
  status      ReviewStatus @default(pending)
  workStatus  WorkStatus   @default(andamento)
  curatorNote String?      @db.Text
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  views     WorkView?
  donations Donation[]

  @@index([authorId])
  @@index([status])
  @@index([medium])
  @@map("works")
}

model WorkView {
  workSlug  String   @id
  work      Work     @relation(fields: [workSlug], references: [slug])
  views     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("work_views")
}

// ------------------------------------------------------------- Doações

model Donation {
  id         String   @id @default(cuid())
  workSlug   String
  work       Work     @relation(fields: [workSlug], references: [slug])
  artistSlug String   @default("")
  artistName String   @default("")
  donorId    String?
  donor      Profile? @relation("DonorProfile", fields: [donorId], references: [id])
  donorName  String   @default("Anônimo")
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([workSlug])
  @@index([donorId])
  @@map("donations")
}

// -------------------------------------------------- Candidaturas de autor

model AuthorApplication {
  id                 String       @id @default(cuid())
  userId             String?
  user               Profile?     @relation(fields: [userId], references: [id])
  artistName         String       // nome real do candidato
  email              String
  phone              String       @default("")
  field              String       @default("") // mantido por compatibilidade
  bio                String       @db.Text
  portfolio          String       @default("") // link externo
  portfolioFiles     String?      @db.Text // JSON: string[]
  portfolioCitations String?      @db.Text
  samples            Int          @default(0)
  message            String?      @db.Text
  status             ReviewStatus @default(pending)
  curatorNote        String?      @db.Text
  decidedAt          DateTime?
  createdAt          DateTime     @default(now())

  @@index([userId])
  @@index([status])
  @@map("author_applications")
}

// ---------------------------------------------------------------- Config do site

model StaffEmail {
  email String  @id
  role  AppRole

  @@map("staff_emails")
}

// Configurações editáveis pelo admin (linha única, id = "default")
model SiteConfig {
  id        String   @id @default("default")
  instagram String   @default("")
  youtube   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  cnpj      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

model CarouselItem {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  imageUrl  String   @default("")
  linkUrl   String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("carousel_item")
}

// ---------------------------------------------------------- Favoritos / Leitura

model UserFavorite {
  id          String   @id @default(cuid())
  userId      String
  workSlug    String
  artistSlug  String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, workSlug])
  @@index([userId])
  @@map("user_favorites")
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  workSlug  String
  pagesRead Int      @default(0)
  finished  Boolean  @default(false)
  chapterNumber Decimal? @db.Decimal(7, 2) // último capítulo aberto
  updatedAt DateTime @updatedAt

  @@unique([userId, workSlug])
  @@index([userId])
  @@map("reading_progress")
}

model WorkLike {
  id        String   @id @default(cuid())
  userId    String
  workSlug  String
  createdAt DateTime @default(now())

  @@unique([userId, workSlug])
  @@index([workSlug])
  @@map("work_likes")
}

model ArtistFollow {
  id         String   @id @default(cuid())
  userId     String
  artistSlug String
  createdAt  DateTime @default(now())

  @@unique([userId, artistSlug])
  @@index([artistSlug])
  @@map("artist_follows")
}

model WorkComment {
  id        String   @id @default(cuid())
  workSlug  String
  userId    String?
  author    String   @default("Anônimo")
  text      String   @db.Text
  hidden    Boolean  @default(false) // oculto pela moderação (ou por 3+ denúncias)
  createdAt DateTime @default(now())

  @@index([workSlug])
  @@map("work_comments")
}

// Quota de leitura diária (leitores free: 10 páginas/dia)
model DailyReadingQuota {
  id             String   @id @default(cuid())
  userId         String
  date           String   // "YYYY-MM-DD"
  pagesConsumed  Int      @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_reading_quota")
}

// Obras selecionadas para o Destaque Beyond (hero carousel)
model DestaqueWork {
  id       String   @id @default(cuid())
  workSlug String   @unique
  order    Int      @default(0)
  addedAt  DateTime @default(now())

  @@map("destaque_works")
}

// Eventos de email registrados via Resend webhook
model EmailEvent {
  id         String   @id @default(cuid())
  eventType  String   // email.sent | email.delivered | email.opened | email.bounced | email.complained
  recipient  String
  subject    String
  resendId   String?
  payload    String   @db.Text // JSON raw do webhook
  createdAt  DateTime @default(now())

  @@index([recipient])
  @@index([eventType])
  @@map("email_events")
}

// Log imutável de alterações e decisões de curadoria — visível apenas a staff
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // work_created | work_edited | work_approved | work_rejected | work_changes | work_status_changed
  workSlug    String
  workTitle   String
  actorId     String
  actorEmail  String
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([workSlug])
  @@index([createdAt])
  @@map("audit_logs")
}

// Lista de espera do plano Leitor Assíduo (/planos em construção)
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      String   @default("") // monthly | quarterly | yearly
  userId    String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

// Perfil público do autor (bio, foto e redes) — chave = id do usuário
model AuthorBio {
  userId    String   @id
  bio       String   @db.Text
  avatarUrl String   @db.Text
  city      String   @default("")
  instagram String   @default("")
  website   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("author_bios")
}

// Leituras por obra e por dia — base do ranking semanal (Top 50)
model WorkViewDaily {
  workSlug String
  date     String // "YYYY-MM-DD" (UTC)
  views    Int    @default(0)

  @@id([workSlug, date])
  @@index([date])
  @@map("work_view_daily")
}

// Idade informada no cadastro (mínimo 13 anos; 13–17 com autorização dos responsáveis)
model UserBirth {
  userId          String   @id
  birthDate       String   // "YYYY-MM-DD"
  guardianConsent Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("user_births")
}

// Limite de requisições (anti-spam/força bruta) — chave ex.: "otp:email:x@y.com"
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@map("rate_limits")
}

// Denúncias de comentários, obras e autores (moderação)
model Report {
  id          String    @id @default(cuid())
  targetType  String    // comment | work | author
  targetId    String    // id do comentário, slug da obra ou slug do autor
  reason      String
  details     String    @db.Text
  reporterId  String
  status      String    @default("open") // open | resolved | dismissed
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

// -------------------------------------------------- Pagamentos (Mercado Pago)

// Cada cobrança guarda a regra de taxa do momento em que foi criada,
// para mudanças futuras de taxa ou modo não alterarem o passado.
model Payment {
  id             String    @id @default(cuid())
  kind           String    @default("donation") // donation | subscription
  status         String    @default("pending") // pending | in_process | approved | rejected | cancelled | refunded | charged_back
  mpPreferenceId String?   @unique
  mpPaymentId    String?   @unique
  userId         String?
  payerName      String    @default("Anônimo")
  artistSlug     String
  artistName     String
  workSlug       String?
  grossCents     Int // valor pago pelo leitor
  feeCents       Int // parte da plataforma
  authorCents    Int // parte do autor
  feeRate        Decimal   @db.Decimal(5, 4)
  feeMode        String // descontada | somada | retida
  method         String?
  paidAt         DateTime?
  payoutAt       DateTime? // repasse ao autor feito
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([artistSlug])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// Regra de taxa das doações (só a equipe vê)
model PaymentConfig {
  id                String   @id @default("default")
  feeRate           Decimal  @default(0.12) @db.Decimal(5, 4)
  feeMode           String   @default("descontada")
  priceFaCents      Int      @default(990) // plano Fã, por mês
  priceSuperFaCents Int      @default(1990) // plano Super Fã, por mês
  updatedAt         DateTime @updatedAt

  @@map("payment_config")
}

// Assinaturas mensais (Fã / Super Fã) pelo Mercado Pago (preapproval)
model Subscription {
  id              String    @id @default(cuid())
  userId          String
  plan            String // fa | superfa
  status          String    @default("pending") // pending | authorized | paused | cancelled
  priceCents      Int // preço do momento da assinatura
  mpPreapprovalId String?   @unique
  payerEmail      String
  nextPaymentAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// -------------------------------------------------- Capítulos, revisões e notificações

// Cada capítulo é um PDF. O autor escolhe o número (0 para prólogo, 1.5 para extra…);
// a lista é ordenada pelo número. Capítulo novo fica 3 dias só para Super Fã (earlyUntil).
model Chapter {
  id          String    @id @default(cuid())
  workId      String
  number      Decimal   @db.Decimal(7, 2)
  title       String?   @db.VarChar(120) // nome opcional: "Capítulo 1 - O começo"
  pdfUrl      String    @db.Text
  previewUrl  String?   @db.Text
  pdfPages    Int?
  publishedAt DateTime  @default(now())
  earlyUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workId, number])
  @@index([workId])
  @@map("chapters")
}

// Alteração de título, sinopse, capa ou PDF de capítulo: passa pela curadoria antes de valer.
// A versão atual continua no ar até a aprovação.
model WorkRevision {
  id         String    @id @default(cuid())
  workId     String
  authorId   String
  kind       String // work | chapter
  chapterId  String?
  data       String    @db.Text // JSON com os campos novos
  status     String    @default("pending") // pending | approved | rejected
  note       String?   @db.Text
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([workId])
  @@map("work_revisions")
}

// Avisos para leitores (ex.: capítulo novo de quem você segue)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // new_chapter | revision_approved | revision_rejected
  title     String
  body      String    @default("") @db.VarChar(500)
  link      String    @default("") @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// Endereço antigo de obra → endereço atual (ex.: sem o sufixo aleatório). Mantém links antigos funcionando.
model WorkSlugAlias {
  oldSlug   String   @id
  newSlug   String
  createdAt DateTime @default(now())

  @@index([newSlug])
  @@map("work_slug_aliases")
}
